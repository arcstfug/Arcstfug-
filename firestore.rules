rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Blueprint: StudentProfile
    function isValidStudentProfile(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 200)) &&
             data.targetExam is string && data.targetExam.size() >= 1 && data.targetExam.size() <= 100 &&
             data.classLevel is string && data.classLevel.size() >= 1 && data.classLevel.size() <= 50 &&
             data.studentGoal is string && data.studentGoal.size() >= 1 && data.studentGoal.size() <= 150 &&
             data.bio is string && data.bio.size() >= 1 && data.bio.size() <= 300 &&
             data.currentStreakDays is int && data.currentStreakDays >= 0 && data.currentStreakDays <= 10000 &&
             data.totalDppsSolved is int && data.totalDppsSolved >= 0 && data.totalDppsSolved <= 100000 &&
             data.overallAccuracy is int && data.overallAccuracy >= 0 && data.overallAccuracy <= 100 &&
             data.lecturesWatched is int && data.lecturesWatched >= 0 && data.lecturesWatched <= 100000 &&
             data.studyHours is number && data.studyHours >= 0 && data.studyHours <= 100000 &&
             data.xp is int && data.xp >= 0 && data.xp <= 10000000 &&
             (!('enrolledCourseIds' in data) || (data.enrolledCourseIds is list && data.enrolledCourseIds.size() <= 50 && (data.enrolledCourseIds.size() == 0 || data.enrolledCourseIds[0] is string))) &&
             (!('bookmarkedLectureIds' in data) || (data.bookmarkedLectureIds is list && data.bookmarkedLectureIds.size() <= 200 && (data.bookmarkedLectureIds.size() == 0 || data.bookmarkedLectureIds[0] is string))) &&
             (!('completedLectureIds' in data) || (data.completedLectureIds is list && data.completedLectureIds.size() <= 500 && (data.completedLectureIds.size() == 0 || data.completedLectureIds[0] is string))) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Validation Blueprint: DppAttempt
    function isValidDppAttempt(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.dppId is string && data.dppId.size() >= 1 && data.dppId.size() <= 100 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 50 &&
             data.score is int && data.score >= 0 && data.score <= 1000 &&
             data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 500 &&
             data.timeSpentSeconds is int && data.timeSpentSeconds >= 0 && data.timeSpentSeconds <= 86400 &&
             data.status is string && (data.status == 'COMPLETED' || data.status == 'PENDING') &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Validation Blueprint: StudentDoubt
    function isValidStudentDoubt(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100 &&
             data.questionText is string && data.questionText.size() >= 1 && data.questionText.size() <= 2000 &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 50 &&
             data.status is string && data.status.size() >= 1 && data.status.size() <= 100 &&
             (!('facultyReply' in data) || data.facultyReply == null || (data.facultyReply is string && data.facultyReply.size() <= 15000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Validation Blueprint: TeacherUpload
    function isValidTeacherUpload(data) {
      return data.authorId is string && data.authorId == request.auth.uid && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
             data.uploadType is string && (data.uploadType == 'VIDEO' || data.uploadType == 'DPP' || data.uploadType == 'MATERIAL') &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 50 &&
             data.chapterTitle is string && data.chapterTitle.size() >= 1 && data.chapterTitle.size() <= 200 &&
             data.courseId is string && data.courseId.size() >= 1 && data.courseId.size() <= 100 &&
             data.resourceUrl is string && data.resourceUrl.size() <= 1000 &&
             data.materialCategory is string && data.materialCategory.size() >= 1 && data.materialCategory.size() <= 100 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 2000 &&
             data.durationMinutes is int && data.durationMinutes >= 0 && data.durationMinutes <= 600 &&
             (!('dppPayloadJson' in data) || data.dppPayloadJson == null || (data.dppPayloadJson is string && data.dppPayloadJson.size() <= 50000)) &&
             data.isPublished is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Collection 1: Student Profiles (/users/{userId})
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll(['userId', 'name', 'targetExam', 'classLevel', 'studentGoal', 'bio', 'currentStreakDays', 'totalDppsSolved', 'overallAccuracy', 'lecturesWatched', 'studyHours', 'xp', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'name', 'email', 'targetExam', 'classLevel', 'studentGoal', 'bio', 'currentStreakDays', 'totalDppsSolved', 'overallAccuracy', 'lecturesWatched', 'studyHours', 'xp', 'enrolledCourseIds', 'bookmarkedLectureIds', 'completedLectureIds', 'createdAt', 'updatedAt']) &&
                       isValidStudentProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidStudentProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'targetExam', 'classLevel', 'studentGoal', 'bio', 'currentStreakDays', 'totalDppsSolved', 'overallAccuracy', 'lecturesWatched', 'studyHours', 'xp', 'enrolledCourseIds', 'bookmarkedLectureIds', 'completedLectureIds', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && existing().userId == request.auth.uid;

      // Subcollection 2: DPP Attempts (/users/{userId}/dpp_attempts/{dppId})
      match /dpp_attempts/{dppId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(dppId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId && existing().userId == request.auth.uid;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(dppId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll(['userId', 'dppId', 'title', 'subject', 'score', 'totalQuestions', 'timeSpentSeconds', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'dppId', 'title', 'subject', 'score', 'totalQuestions', 'timeSpentSeconds', 'status', 'createdAt', 'updatedAt']) &&
                         isValidDppAttempt(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(dppId) &&
                         request.auth.uid == userId &&
                         isValidDppAttempt(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().dppId == existing().dppId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'subject', 'score', 'totalQuestions', 'timeSpentSeconds', 'status', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(dppId) && request.auth.uid == userId && existing().userId == request.auth.uid;
      }

      // Subcollection 3: Student Doubts (/users/{userId}/doubts/{doubtId})
      match /doubts/{doubtId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(doubtId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId && existing().userId == request.auth.uid;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(doubtId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll(['userId', 'studentName', 'questionText', 'subject', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'studentName', 'questionText', 'subject', 'status', 'facultyReply', 'createdAt', 'updatedAt']) &&
                         isValidStudentDoubt(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(doubtId) &&
                         request.auth.uid == userId &&
                         isValidStudentDoubt(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['studentName', 'questionText', 'subject', 'status', 'facultyReply', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(doubtId) && request.auth.uid == userId && existing().userId == request.auth.uid;
      }
    }

    // Collection 4: Teacher Uploads (/teacher_uploads/{uploadId})
    match /teacher_uploads/{uploadId} {
      allow get: if isSignedIn() && isValidId(uploadId) && (resource == null || existing().isPublished == true || existing().authorId == request.auth.uid);
      allow list: if isSignedIn() && existing().isPublished == true;

      allow create: if isSignedIn() &&
                       isValidId(uploadId) &&
                       incoming().keys().hasAll(['authorId', 'authorName', 'uploadType', 'title', 'subject', 'chapterTitle', 'courseId', 'resourceUrl', 'materialCategory', 'description', 'durationMinutes', 'isPublished', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['authorId', 'authorName', 'uploadType', 'title', 'subject', 'chapterTitle', 'courseId', 'resourceUrl', 'materialCategory', 'description', 'durationMinutes', 'dppPayloadJson', 'isPublished', 'createdAt', 'updatedAt']) &&
                       isValidTeacherUpload(incoming());

      allow update: if isSignedIn() &&
                       isValidId(uploadId) &&
                       existing().authorId == request.auth.uid &&
                       isValidTeacherUpload(incoming()) &&
                       incoming().authorId == existing().authorId &&
                       incoming().uploadType == existing().uploadType &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['authorName', 'title', 'subject', 'chapterTitle', 'courseId', 'resourceUrl', 'materialCategory', 'description', 'durationMinutes', 'dppPayloadJson', 'isPublished', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(uploadId) && existing().authorId == request.auth.uid;
    }
  }
}
